{
  "name": "decode-cli",
  "version": "0.1.0",
  "description": "AI-powered developer productivity CLI — API health checks, GitHub activity analysis, documentation generation, and AI-assisted code edits with human approval.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "decode": "bin/decode.js"
  },
  "files": [
    "bin",
    "dist",
    "decode.config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --splitting=false --jsx=automatic --jsx-import-source=react --log-level=warning",
    "dev": "tsx bin/decode.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "figlet": "^1.11.4",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "inquirer": "^9.2.23",
    "octokit": "^3.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8.57.0",
    "execa": "^8.0.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "vitest": "^3.2.7"
  }
}
