# Copy this file to .env and fill in your own values. Never commit .env.

# LLM Provider (routed via your chosen router/provider)
LLM_PROVIDER_API_KEY=
# Optional: override the provider's base URL. An OpenAI-compatible root such
# as https://api.groq.com/openai/v1 is accepted — DeCode appends the endpoint
# path without duplicating the version segment.
LLM_PROVIDER_BASE_URL=

# GitHub
GITHUB_TOKEN=

# Optional: default target for API checks
DEFAULT_API_BASE_URL=
